{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // resolve the sibling source package by path (worktree-safe: a linked
    // node_modules would otherwise typecheck against another checkout)
    "paths": {
      "@selfoffice/compound-file": ["../compound-file/src/index.ts"],
      "@selfoffice/docx-engine": ["../docx-engine/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
