{
  "name": "@selfoffice/odf2ooxml",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "ODF filters: .odt/.ods/.odp import (to .docx/.pptx via docx-engine / pptx-engine) and .docx/.xlsx/.pptx export to .odt/.ods/.odp, all local",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@selfoffice/docx-engine": "*",
    "@selfoffice/pptx-engine": "*",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
