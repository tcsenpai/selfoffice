{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      // resolve workspace types from this checkout's sources: in a git worktree
      // node_modules is a symlink into the main checkout, so bare specifiers
      // would typecheck against the other checkout's (possibly stale) types
      "@selfoffice/docx-engine": ["../../packages/docx-engine/src/index.ts"],
      "@selfoffice/font-metrics": ["../../packages/font-metrics/src/index.ts"],
      "@selfoffice/font-metrics/resolve": ["../../packages/font-metrics/src/resolve.ts"],
      "@selfoffice/font-metrics/word-faces.json": ["../../packages/font-metrics/word-faces.json"],
      "@selfoffice/electron-utils/headless-export": [
        "../../packages/electron-utils/src/headless-export.ts"
      ],
      "@selfoffice/electron-utils/atomic-write": [
        "../../packages/electron-utils/src/atomic-write.ts"
      ],
      "@selfoffice/electron-utils": ["../../packages/electron-utils/src/index.ts"],
      "@selfoffice/ai-provider": ["../../packages/ai-provider/src/index.ts"],
      "@selfoffice/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@selfoffice/i18n": ["../../packages/i18n/src/index.ts"],
      "@selfoffice/ui": ["../../packages/ui/src/index.ts"],
      "@selfoffice/xlsx-gateway/*": ["../../packages/xlsx-gateway/src/*"]
    }
  },
  "include": ["src", "tests", "electron.vite.config.ts", "vitest.config.ts"]
}
